# ============================================================
# VARIÁVEIS DE AMBIENTE — Sistema Chapecoense
# ============================================================
# Copie este arquivo para .env e preencha com seus valores:
#   cp .env.example .env
#
# NUNCA envie o arquivo .env para o Git.
# ============================================================

# Banco de dados
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chapecoense_dev
DB_USER=app_chapecoense
DB_PASS=sua_senha_aqui

# Aplicação
NODE_ENV=development
PORT=3000

# Segurança — gere uma chave longa e aleatória para produção
# Sugestão: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=troque_esta_chave_em_producao
JWT_EXPIRES_IN=8h
